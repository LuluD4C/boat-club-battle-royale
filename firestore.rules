rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Open for the event only. Anyone with the link can play, so change the
    // date to the day after your game and nothing can be written after that.
    match /games/{game}/{document=**} {
      allow read, write: if request.time < timestamp.date(2026, 12, 31);
    }
  }
}
